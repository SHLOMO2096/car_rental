# ── Required ──────────────────────────────────────────────────────────────────
DB_USER=carrental
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=carrental

# openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_32_BYTE_HEX_SECRET

FRONTEND_URL=https://your-domain.co.il
PUBLIC_HOST=your-domain.co.il

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# ברירת המחדל ב-docker-compose.prod.yml היא שירות ה-redis שבתוך ה-stack.
# memory = מונים per-process (נשבר עם יותר מ-replica אחת של backend).
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# ── Email (optional) ──────────────────────────────────────────────────────────
EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=
EMAILS_FROM_NAME="וואי קאר"
SECURITY_ALERT_RECIPIENTS=ops@your-domain.co.il,security@your-domain.co.il
